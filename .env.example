# =============================================================================
# piano-app (LouvorJA PIANO desktop) — .env.example ATUALIZADO
# Atualizado em 09/10/2026 (release sob medida campanha SrCaldeira).
# Regra: valores REAIS nunca neste arquivo — cada dev coloca os seus no
# .env.local (gitignored). Este arquivo É versionado.
# =============================================================================

# --- Catálogo / mídias (produção, públicos) --------------------------------
# URL da API de catálogo (json_db) — primária.
VITE_URL_DATABASE=https://api.pianolouvorja.com.br/json_db

# Base de arquivos (covers, mídias).
VITE_URL_FILES=https://api.pianolouvorja.com.br/file

# Base da API de coletâneas custom + login (v1/custom, auth). Usada por
# custom-catalog.ts e auth-client.ts.
VITE_PALCO_API_URL=https://api.pianolouvorja.com.br

# Main process (Electron): download de mídia offline e fallback local://.
# Deve espelhar o mesmo host de VITE_PALCO_API_URL.
PIANO_API_BASE_URL=https://api.pianolouvorja.com.br

# Fallbacks em cascata (separados por vírgula) — quando a API primária cair.
# NÃO use LOUVORJA_FALLBACK_URLS — esse nome não é lido.
VITE_API_FALLBACK_URLS=https://api.louvorja.com.br,https://api.louvorja.workers.dev

# Token de acesso às rotas autenticadas da API. Cada dev usa o seu (dev usa
# staging). Sem valor, rotas autenticadas falham.
VITE_API_TOKEN=

# --- Firebase (renderer) — colar do console Firebase do projeto -------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Diagnóstico / GlitchTip (NOVO em 09/10/2026) ---------------------------
# DSN pública de ingestão do projeto louvorja-desktop (id 1) em
# errors.pianolouvorja.com.br. É chave PÚBLICA por design (pode ir no binário),
# mas NUNCA commitar valor aqui: vive no GitHub Secret
# DIAGNOSTICS_GLITCHTIP_DSN (criado 09/10/2026) e é injetada no build.
#
# Ordem de consumo no código (electron/diagnostics.mjs):
#   1. Portable Windows: arquivo resources/diagnostics-dsn.txt DENTRO do EXE
#      (gerado de build/diagnostics-dsn.txt no momento do build — gitignored;
#      electron-builder copia via extraResources do package.json).
#   2. Dev/CI: esta env DIAGNOSTICS_GLITCHTIP_DSN no processo main.
#   3. Sem nenhuma: envio desabilitado, fallback arquivo (JSON/TXT).
#
# Recipe de build portable (worktree):
#   export DIAGNOSTICS_GLITCHTIP_DSN='https://<key>@errors.pianolouvorja.com.br/1'
#   printf '%s' "$DIAGNOSTICS_GLITCHTIP_DSN" > build/diagnostics-dsn.txt
#   npm run electron:build -- --win portable --x64
DIAGNOSTICS_GLITCHTIP_DSN=
