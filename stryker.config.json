{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing config para pianolouvorja/app. Rodar: npx stryker run",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/plugins/i18n.ts",
    "src/modules/sync/services/library-catalog.ts",
    "src/modules/liturgy/services/**/*.ts",
    "src/modules/community/services/notifications.ts",
    "src/modules/community/components/NotificationsDropdown.vue",
    "src/modules/community/components/NotificationsPanel.vue",
    "src/modules/community/components/ReportDialog.vue",
    "src/modules/community/services/ranking.ts",
    "src/modules/community/services/weekly-tasks.ts",
    "src/modules/community/services/seasonal-event.ts",
    "src/modules/community/services/community-catalog.ts"
  ],
  "ignorePatterns": [
    ".worktrees",
    "reports",
    "coverage",
    "dist",
    ".stryker-tmp"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "timeoutMS": 30000,
  "concurrency": 1,
  "warnings": false
}
