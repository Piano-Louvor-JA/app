#!/bin/bash
# husky v9 wrapper roda 'sh -e' (dash); pipefail exige bash — re-exec
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi
set -euo pipefail
# Preserve npm failures through output filtering; use actual project script.
echo "🔍 Pre-commit: lint + typecheck..."
npm run lint --if-present 2>&1 | tail -3
npm run type-check 2>&1 | tail -3
echo "✅ Pre-commit OK"
