{
  "name": "louvorja-piano",
  "version": "1.29.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "louvorja-piano.desktop",
  "scripts": {
    "version:major": "npm version major -m \"chore: versão %s\"",
    "version:minor": "npm version minor -m \"chore: versão %s\"",
    "version:patch": "npm version patch -m \"chore: versão %s\"",
    "version:max": "npm run version:major",
    "version:min": "npm run version:minor",
    "version:bug": "npm run version:patch",
    "dev": "vite",
    "preview": "vite preview",
    "host": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build --base=./",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "git:tag": "git tag -a \"v$npm_package_version\" -m \"Versão $npm_package_version\" && git push origin \"v$npm_package_version\"",
    "git:publish": "git push -u origin HEAD --follow-tags",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron . --class=louvorja-piano\"",
    "electron:preview": "vite build --base=./ && env -u ELECTRON_RUN_AS_NODE electron . --class=louvorja-piano",
    "electron:build": "vite build --base=./ && node build/patch-nsis-templates.mjs && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test:regression": "node scripts/test-regression.mjs"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tabler/icons-webfont": "^3.45.0",
    "basic-ftp": "^6.0.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4",
    "vuetify": "^4.1.4",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^9.0.2",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5",
    "wait-on": "^9.0.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "@tabler/icons-webfont": {
      "svgtofont": "npm:noop2@2.0.0",
      "svg-path-commander": "npm:noop2@2.0.0",
      "@tabler/icons": "npm:noop2@2.0.0"
    }
  },
  "build": {
    "appId": "com.louvorja.piano",
    "productName": "LouvorJA - PIANO",
    "executableName": "louvorja-piano",
    "artifactName": "LouvorJA-PIANO-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/ico/**/*",
      "docs/LEGAL/eula/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/midia/modulos/sorteios",
        "to": "midia/modulos/sorteios"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icons",
      "executableName": "louvorja-piano",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "LouvorJA - PIANO",
          "Comment": "LouvorJA - PIANO — aplicativo desktop para gerenciamento de culto",
          "Categories": "AudioVideo;",
          "StartupWMClass": "louvorja-piano",
          "MimeType": "application/x-louvorja-liturgy;"
        }
      },
      "mimeTypes": [
        "application/x-louvorja-liturgy"
      ]
    },
    "deb": {
      "afterInstall": "build/linux-after-install.tpl"
    },
    "rpm": {
      "afterInstall": "build/linux-after-install.tpl"
    },
    "pacman": {
      "afterInstall": "build/linux-after-install.tpl"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "license": "electron/legal/eula/pt-BR.txt",
      "include": "build/nsis-eula.nsh",
      "installerLanguages": [
        "pt_BR",
        "en_US",
        "es_ES"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "pianolouvorja",
      "repo": "app"
    },
    "fileAssociations": [
      {
        "ext": "ja",
        "name": "LouvorJA Liturgia",
        "description": "Liturgia exportada pelo LouvorJA Delphi",
        "role": "Editor"
      }
    ]
  },
  "description": "LouvorJA - PIANO — aplicativo desktop para gerenciamento de culto",
  "author": {
    "name": "Ezequias Fonseca",
    "email": "ezequias@pianolouvorja.com.br"
  }
}
